# Backend API port. Keep the production Nginx proxy and PM2 config in sync.
API_PORT="3001"

# Login brute-force protection. Successful logins do not consume this quota.
LOGIN_RATE_LIMIT_WINDOW_MS="900000"
LOGIN_RATE_LIMIT_MAX="8"

# External inventory API token. Set a long random value before enabling third-party integrations.
OPEN_API_TOKEN="CHANGE_ME_TO_A_LONG_RANDOM_TOKEN"
OPEN_API_RATE_LIMIT_WINDOW_MS="60000"
OPEN_API_RATE_LIMIT_MAX="240"

# PostgreSQL is required for the backend API. The server no longer persists
# business data to data/app-state.json.
DATABASE_URL="postgresql://gpu_erp_user:CHANGE_ME@127.0.0.1:5432/gpu_erp"

# Set to true only when your PostgreSQL provider requires SSL.
DATABASE_SSL="false"

# On first PostgreSQL startup, import legacy data/app-state.json if it exists.
POSTGRES_IMPORT_LEGACY_JSON="true"

# Daily PostgreSQL backup. The production cron runs scripts/pg_backup.sh at 03:20.
# BACKUP_DIR defaults to ../gpu-erp-backups relative to the application directory.
BACKUP_RETENTION_DAYS="30"

# Optional: send a Feishu group message after a sales order is created.
# Keep the real webhook only in .env; never commit it.
FEISHU_SALES_WEBHOOK_URL=""
FEISHU_NOTIFICATION_TIMEOUT_MS="5000"

# Daily owner/finance report. Leave the URL empty to reuse FEISHU_SALES_WEBHOOK_URL (the outbound robot).
FEISHU_DAILY_REPORT_WEBHOOK_URL=""
FEISHU_DAILY_REPORT_CUTOFF="20:00"
FEISHU_DAILY_REPORT_MAX_ATTEMPTS="3"
FEISHU_DAILY_REPORT_RETRY_SECONDS="75"

# AI operating suggestions. Keep the API key on the server only; never expose it to the browser.
# DeepSeek's OpenAI-compatible endpoint is https://api.deepseek.com.
AI_PROVIDER="deepseek"
AI_BASE_URL="https://api.deepseek.com"
AI_MODEL="deepseek-v4-flash"
AI_API_KEY=""
# Required in production. Used only when the initial owner account is first bootstrapped.
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
